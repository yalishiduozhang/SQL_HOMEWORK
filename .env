# ================================
# MovieHunter 环境配置文件示例
# ================================
# 
# 使用方法：
# 1. 复制此文件为 .env
#    cp .env.example .env
# 
# 2. 根据您的环境修改配置值
# 
# 3. Docker Compose 会自动加载 .env 文件中的变量
# 
# 注意：.env 文件包含敏感信息，不应提交到版本控制
# ================================

# MySQL 数据库配置
# --------------------------------
# MySQL root 用户密码（用于数据库管理）
MYSQL_ROOT_PASSWORD=moviehunter_root_password

# 应用使用的数据库名称
MYSQL_DATABASE=moviehunter

# 应用数据库用户名
MYSQL_USER=moviehunter_user

# 应用数据库密码（请修改为安全密码）
MYSQL_PASSWORD=moviehunter_password

# 应用配置
# --------------------------------
# 数据库主机地址（Docker 内部服务名）
MYSQL_HOST=mysql

# 数据库端口
MYSQL_PORT=3306

# Flask 运行环境（production/development）
FLASK_ENV=production

# 可选配置
# --------------------------------

# Web 应用端口（默认 80）
WEB_PORT=80

# MySQL 外部访问端口（默认 3306）
# MYSQL_EXTERNAL_PORT=3306
